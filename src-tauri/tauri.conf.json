{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BypassNote",
  "version": "0.3.0",
  "identifier": "com.mapersmusic.bypassnote",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BypassNote",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "BypassNote desktop app",
    "longDescription": "BypassNote is a music practice tool to create, organize and share bypass notes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
